# BizAssist AI - Environment Variables Template
# Yeh file Git mein jayegi (safe hai).
# Iska copy bana kar .env naam rakh dein aur asli values daalein.

APP_NAME=BizAssist AI
APP_ENV=development
DEBUG=true

# LLM API (Groq - free tier)
GROQ_API_KEY=your_groq_api_key_here

# Embeddings API (Hugging Face - free tier)
HF_API_TOKEN=your_huggingface_token_here

# Database (Phase 10)
DATABASE_URL=postgresql://user:password@localhost:5432/bizassist

# Security (Phase 11)
JWT_SECRET_KEY=change_this_to_a_random_string
JWT_ALGORITHM=HS256